// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum userRole {
  admin
  member
  owner
  user
}

enum roomType {
  STANDARD
  DELUXE
  SUITE
  PRESIDENTIAL
}

enum invitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}
